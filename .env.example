# Copy this file to .env.local and fill in values. Never commit .env.local.
# Get all values from your Firebase project (see docs/SETUP.md and docs/MEMBERSHIP_API.md).

# ---------------------------------------------------------------------------
# Client (browser) – Firebase Web App config
# Firebase Console → Project settings → General → Your apps → Web app (or add one)
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Server (API) – Firebase Admin SDK (for /api/membership)
# Firebase Console → Project settings → Service accounts → Generate new private key
# Use the JSON fields: project_id, client_email, private_key
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Optional – Membership API emails and “Not me” link (see docs/RESEND_SETUP.md)
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=Technical Investment Association <membership@tiaassociation.com>
# Public URL of your site – used for all links in emails (confirm, unsubscribe, deactivate, update profile).
# Recipients click these links in their inbox, so this must be a URL anyone can open (your live domain), not localhost.
# PUBLIC_BASE_URL=http://localhost:3000
# For production (required for real signups): PUBLIC_BASE_URL=https://tiaassociation.com
